# =============================================================================
# ADOFAI Battle / Online contest — FULL template → copy to .env.local
# Repo: https://github.com/3289david/adofai-battle
# (If you typed "Balltel" — same app; no separate Balltel service in this setup.)
# =============================================================================

# This app’s public URL — MUST match an OAuth redirect URI registered on the IdP
# e.g. https://YOUR_CONTEST_HOST/api/auth/oauth/callback
# Default Next dev is :3000; use :3001 if another app already uses 3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Central IdP
NEXT_PUBLIC_AUTH_ISSUER="https://auth.adofai.net"

# OAuth client id (seeded on IdP as adofai_online_contest)
OAUTH_CLIENT_ID="adofai_online_contest"

# NODE_ENV is normally set by the platform (production / development)
